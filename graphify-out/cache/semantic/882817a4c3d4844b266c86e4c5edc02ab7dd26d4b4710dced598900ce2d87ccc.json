{"nodes": [{"id": "docs_superpowers_specs_2026_07_06_session_tracking_and_close_to_minimize_design", "label": "Play-Session Tracking + Close-to-Minimize \u2014 Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-06-session-tracking-and-close-to-minimize-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_session_tracking_close_to_minimize", "label": "Play-Session Tracking (last_played/play_time_secs) + Close-to-Minimize", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-06-session-tracking-and-close-to-minimize-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "last_played is written the moment launch succeeds (matches official-launcher convention: record session start, not end, so a hard-killed launcher doesn't lose the record); play_time_secs accumulates in the exit-watch poll loop. on_close_requested minimizes instead of quitting while running_procs is non-empty, deferring quit via a pending_quit AtomicBool that either triggers slint::quit_event_loop() on clean all-exit or restores the window on any abnormal exit."}, {"id": "src_view_mod_on_close_requested", "label": "Window::on_close_requested handler (src/view/mod.rs)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-07-06-session-tracking-and-close-to-minimize-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_06_session_tracking_and_close_to_minimize_design", "target": "concept_session_tracking_close_to_minimize", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-06-session-tracking-and-close-to-minimize-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_sp