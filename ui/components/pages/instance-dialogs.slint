// 右鍵選單用的小對話框：重新命名 / 刪除確認
import { InstanceLogic } from "@global";

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <string> kind: "normal"; // normal / primary / danger
    callback clicked();

    width: 90px;
    height: 34px;
    border-radius: 8px;
    border-width: root.kind == "normal" ? 1px : 0px;
    border-color: #ffffff.with-alpha(0.15);
    background: root.kind == "danger"
        ? (db-ta.has-hover ? #e05050 : #c04040)
        : (root.kind == "primary"
            ? (db-ta.has-hover ? #67ab44 : #5a9a3a)
            : (db-ta.has-hover ? #ffffff.with-alpha(0.1) : transparent));

    db-ta := TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.label;
        color: root.kind == "normal" ? #888 : white;
        font-size: 13px;
        font-weight: root.kind == "normal" ? 400 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component RenameInstanceDialog inherits Rectangle {
    background: #000000.with-alpha(0.6);
    TouchArea { }

    Rectangle {
        width: 380px;
        height: 190px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e2028;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ffffff.with-alpha(0.1);

        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            Text {
                text: @tr("Rename Instance");
                font-size: 15px;
                font-weight: 600;
                color: #e0e0e0;
            }

            Rectangle {
                height: 36px;
                border-radius: 6px;
                border-width: 1px;
                border-color: #ffffff.with-alpha(0.15);
                background: #242424;
                rn-input := TextInput {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    text <=> InstanceLogic.rename-text;
                    color: #e0e0e0;
                    font-size: 13px;
                    vertical-alignment: center;
                    accepted => { InstanceLogic.confirm-rename(); }
                }
            }

            if InstanceLogic.rename-error != "": Text {
                text: InstanceLogic.rename-error;
                color: #e74c3c;
                font-size: 12px;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton {
                    label: @tr("Cancel");
                    clicked => { InstanceLogic.show-rename = false; }
                }

                DialogButton {
                    label: @tr("Rename");
                    kind: "primary";
                    clicked => { InstanceLogic.confirm-rename(); }
                }
            }
        }
    }
}

export component DeleteInstanceDialog inherits Rectangle {
    background: #000000.with-alpha(0.6);
    TouchArea { }

    Rectangle {
        width: 420px;
        height: 180px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e2028;
        border-radius: 12px;
        border-width: 1px;
        border-color: #c04040.with-alpha(0.4);

        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            Text {
                text: @tr("Delete Instance");
                font-size: 15px;
                font-weight: 600;
                color: #e0e0e0;
            }

            Text {
                text: @tr("Delete \"{}\"? All worlds, mods and settings of this instance will be permanently removed.", InstanceLogic.delete-name);
                font-size: 12px;
                color: #9e9e9e;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton {
                    label: @tr("Cancel");
                    clicked => { InstanceLogic.show-delete-confirm = false; }
                }

                DialogButton {
                    label: @tr("Delete");
                    kind: "danger";
                    clicked => { InstanceLogic.confirm-delete(); }
                }
            }
        }
    }
}
