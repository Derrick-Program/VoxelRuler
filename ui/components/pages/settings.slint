import { AppTheme } from "@theme";
import { SettingsLogic } from "@global";
import { ComboBox, ListView } from "std-widgets.slint";

export component Settings inherits Rectangle {
    width: 100%;
    height: 100%;

    VerticalLayout {
        padding: 28px;
        spacing: 20px;
        alignment: start;

        Text {
            text: @tr("Settings");
            font-size: 24px;
            font-weight: 800;
            color: AppTheme.colors.foreground;
        }

        Rectangle {
            border-radius: 12px;
            border-width: 1px;
            border-color: #ffffff.with-alpha(0.1);
            background: AppTheme.colors.background.brighter(8%);

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: @tr("Global Java");
                    font-size: 15px;
                    font-weight: 700;
                    color: AppTheme.colors.foreground;
                }

                Text {
                    text: @tr("Used by every instance set to \"Use Global Settings\".");
                    font-size: 12px;
                    color: #888;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("Java"); font-size: 12px; color: #9e9e9e; }
                    ComboBox {
                        height: 36px;
                        model: SettingsLogic.java-mode-list;
                        current-value <=> SettingsLogic.selected-java-mode;
                    }
                }

                if SettingsLogic.selected-java-mode == "Use Custom Java": VerticalLayout {
                    spacing: 6px;

                    Text { text: @tr("Detected Java Installations"); font-size: 12px; color: #9e9e9e; }

                    Rectangle {
                        height: 120px; border-radius: 6px;
                        border-width: 1px; border-color: #ffffff.with-alpha(0.15);
                        background: #242424;
                        clip: true;

                        if SettingsLogic.detected-java-list.length == 0: Text {
                            text: @tr("No Java installation found");
                            color: #555; font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }

                        ListView {
                            width: parent.width; height: parent.height;
                            for path in SettingsLogic.detected-java-list: Rectangle {
                                height: 28px;
                                background: SettingsLogic.java-path == path
                                    ? #2e5b22
                                    : (row-ta.has-hover ? #ffffff.with-alpha(0.06) : transparent);
                                row-ta := TouchArea {
                                    clicked => { SettingsLogic.java-path = path; }
                                }
                                Text {
                                    x: 10px; width: parent.width - 20px; height: parent.height;
                                    text: path;
                                    color: SettingsLogic.java-path == path ? #d7f5c9 : #c0c0c0;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 90px; height: 30px; border-radius: 6px;
                            border-width: 1px; border-color: #ffffff.with-alpha(0.2);
                            background: browse-ta.has-hover ? #ffffff.with-alpha(0.1) : #2a2a2a;
                            browse-ta := TouchArea { clicked => { SettingsLogic.browse-java(); } }
                            Text {
                                text: @tr("Browse...");
                                color: #e0e0e0; font-size: 12px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: SettingsLogic.java-path == ""
                                ? @tr("No Java selected")
                                : SettingsLogic.java-path;
                            color: SettingsLogic.java-path == "" ? #555 : #9e9e9e;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 110px; height: 34px; border-radius: 8px;
                        background: save-ta.has-hover ? #67ab44 : #5a9a3a;
                        save-ta := TouchArea { clicked => { SettingsLogic.save-settings(); } }
                        Text {
                            text: @tr("Save"); color: white;
                            font-size: 13px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    Text {
                        text: SettingsLogic.status-msg;
                        font-size: 12px;
                        color: #76bc51;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
