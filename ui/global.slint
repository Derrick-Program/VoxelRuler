        debug("Create new instance");
    }
    launch_instance(id) => {
        debug("Launch instance with id: " + id);
    }
    kill_instance(id) => {
        debug("Kill instance with id: " + id);
    }
    open_instance_settings(id) => {
        debug("Open settings for instance with id: " + id);
    }
    in-out property <string> search-text;
    callback search-changed(string);

    in-out property <bool> is-installing: false;
    in-out property <float> install-progress: 0.0;
    in-out property <string> install-status: "";
    in-out property <bool> install-is-error: false;
    callback dismiss-install-dialog();

    in-out property <bool> show-log: false;
    in-out property <string> log-instance-id: "";
    in-out property <[LogLine]> log-lines: [];
    callback open-log(string);
    callback close-log();

    // ── 右鍵選單操作 ─────────────────────────────────────────────
    callback open-instance-folder(string);
    callback duplicate-instance(string);

    // 重新命名對話框
    in-out property <bool> show-rename: false;
    in-out property <string> rename-id: "";
    in-out property <string> rename-text: "";
    in-out property <string> rename-error: "";
    callback confirm-rename();

    // 刪除確認對話框
    in-out property <bool> show-delete-confirm: false;
    in-out property <string> delete-id: "";
    in-out property <string> delete-name: "";
    callback confirm-delete();
}

// ── 實例詳細視窗（Prism 式側欄分頁）────────────────────────────────

// 分頁索引：0 Minecraft紀錄檔 / 1 版本 / 2 模組 / 3 資源包 / 4 光影包 /
//          5 筆記 / 6 世界 / 7 伺服器 / 8 螢幕擷取畫面 / 9 設定 / 10 其他紀錄檔

export struct InstanceFileEntry {
    file-name: string,
    info: string,
    enabled: bool,
}

export struct WorldRow {
    dir-name: string,
    level-name: string,
    info: string,
}

export struct ServerRow {
    name: string,
    ip: string,
}

export struct ScreenshotRow {
    file-name: string,
    thumb: image,
}

export global InstanceDetailLogic {
    in-out property <bool> show-dialog: false;
    in-out property <string> instance-id: "";
    in-out property <string> instance-name: "";
    in-out property <int> active-tab: 0;
    in-out property <string> status-msg: "";

    // 0：Minecraft 紀錄檔（live）
    in-out property <[LogLine]> live-log-lines: [];
    in-out property <bool> instance-running: false;

    // 1：版本
    in-out property <string> version: "";
    in-out property <string> mod-loader: "";
    in-out property <[string]> version-list: [];
    in-out property <string> selected-version: "";
    callback save-version();

    // 2/3/4：模組 / 資源包 / 光影包（category key："mods" / "resourcepacks" / "shaderpacks"）
    in-out property <[InstanceFileEntry]> mods: [];
    in-out property <[InstanceFileEntry]> resource-packs: [];
    in-out property <[InstanceFileEntry]> shader-packs: [];
    callback toggle-entry(string, string);  // category, file-name
    callback delete-entry(string, string);  // category, file-name（世界/截圖也共用）
    callback add-entry(string);             // category → 檔案選擇框
    // 兩段式刪除確認："category/file-name"，再點一次才真的刪
    in-out property <string> pending-delete-key: "";

    // 5：筆記
    in-out property <string> notes: "";
    in-out property <string> notes-status: "";
    callback save-notes();

    // 6：世界
    in-out property <[WorldRow]> worlds: [];

    // 7：伺服器
    in-out property <[ServerRow]> servers: [];

    // 8：螢幕擷取畫面
    in-out property <[ScreenshotRow]> screenshots: [];

    // 10：其他紀錄檔
    in-out property <[string]> other-logs: [];
    in-out property <string> viewing-log-name: "";
    in-out property <[string]> other-log-content: [];
    callback view-log-file(string);

    // 視窗控制與導航
    callback open-detail(string, int);  // instance-id, tab
    callback close-detail();
    callback tab-changed(int);
    callback open-subfolder(string);    // category key（"root" = 實例根目錄）
}

export struct ModData {
    id: string,
    name: string,
    mod_loader: string,
    author: string,
    description: string,
    image: image,
}

