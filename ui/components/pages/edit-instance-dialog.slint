import { InstanceEditLogic } from "@global";
import { ComboBox } from "std-widgets.slint";

export component EditInstanceDialog inherits Rectangle {
    background: #000000.with-alpha(0.6);

    Rectangle {
        width: 460px;
        height: 480px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e2028;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ffffff.with-alpha(0.1);

        VerticalLayout {
            // ── Header ──────────────────────────────────────────────
            Rectangle {
                height: 52px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;
                    alignment: space-between;
                    Text {
                        text: @tr("Edit Instance") + " — " + InstanceEditLogic.instance-name;
                        font-size: 15px;
                        font-weight: 600;
                        color: #e0e0e0;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: x-ta.has-hover ? #ffffff.with-alpha(0.1) : transparent;
                        x-ta := TouchArea { clicked => { InstanceEditLogic.cancel-edit(); } }
                        Text {
                            text: "✕";
                            color: #888;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #ffffff.with-alpha(0.08); }

            // ── Content ─────────────────────────────────────────────
            Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 20px; spacing: 16px; alignment: start;

                    // Memory
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Max Memory (Xmx)"); width: 150px;
                            font-size: 13px; color: #e0e0e0; vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                            border-width: 1px; border-color: #ffffff.with-alpha(0.15);
                            background: #242424;
                            xmx-input := TextInput {
                                x: 12px; width: parent.width - 24px; height: parent.height;
                                text <=> InstanceEditLogic.xmx;
                                color: #e0e0e0; font-size: 13px; vertical-alignment: center;
                            }
                            if xmx-input.text == "": Text {
                                x: 12px; height: parent.height;
                                text: "2G";
                                color: #555; font-size: 13px; vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Init Memory (Xms)"); width: 150px;
                            font-size: 13px; color: #e0e0e0; vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                            border-width: 1px; border-color: #ffffff.with-alpha(0.15);
                            background: #242424;
                            xms-input := TextInput {
                                x: 12px; width: parent.width - 24px; height: parent.height;
                                text <=> InstanceEditLogic.xms;
                                color: #e0e0e0; font-size: 13px; vertical-alignment: center;
                            }
                            if xms-input.text == "": Text {
                                x: 12px; height: parent.height;
                                text: "512M";
                                color: #555; font-size: 13px; vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #ffffff.with-alpha(0.08); }

                    // Java runtime
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: @tr("Java Runtime"); font-size: 12px; color: #9e9e9e; }
                        ComboBox {
                            height: 36px;
                            model: InstanceEditLogic.java-runtime-list;
                            current-value <=> InstanceEditLogic.selected-java-runtime;
                        }
                    }

                    // Java custom path
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: @tr("Custom Java Path (overrides runtime)"); font-size: 12px; color: #9e9e9e; }
                        Rectangle {
                            height: 36px; border-radius: 6px;
                            border-width: 1px; border-color: #ffffff.with-alpha(0.15);
                            background: #242424;
                            jp-input := TextInput {
                                x: 12px; width: parent.width - 24px; height: parent.height;
                                text <=> InstanceEditLogic.java-path;
                                color: #e0e0e0; font-size: 13px; vertical-alignment: center;
                            }
                            if jp-input.text == "": Text {
                                x: 12px; height: parent.height;
                                text: @tr("e.g. /usr/bin/java (optional)");
                                color: #555; font-size: 13px; vertical-alignment: center;
                            }
                        }
                        Text {
                            text: @tr("Priority: custom path > runtime > global settings > Minecraft default");
                            font-size: 11px; color: #666; wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #ffffff.with-alpha(0.08); }

            // ── Footer ──────────────────────────────────────────────
            Rectangle {
                min-height: 64px;
                VerticalLayout {
                    padding-top: 8px;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    alignment: center;

                    if InstanceEditLogic.error-msg != "": Text {
                        text: InstanceEditLogic.error-msg;
                        color: #e74c3c; font-size: 12px;
                        horizontal-alignment: right; wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end; spacing: 8px;

                        Rectangle {
                            width: 80px; height: 34px; border-radius: 8px;
                            border-width: 1px; border-color: #ffffff.with-alpha(0.15);
                            background: cancel-ta.has-hover ? #ffffff.with-alpha(0.1) : transparent;
                            cancel-ta := TouchArea { clicked => { InstanceEditLogic.cancel-edit(); } }
                            Text {
                                text: @tr("Cancel"); color: #888; font-size: 13px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 110px; height: 34px; border-radius: 8px;
                            background: confirm-ta.has-hover ? #67ab44 : #5a9a3a;
                            confirm-ta := TouchArea { clicked => { InstanceEditLogic.confirm-edit(); } }
                            Text {
                                text: @tr("Save"); color: white;
                                font-size: 13px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
