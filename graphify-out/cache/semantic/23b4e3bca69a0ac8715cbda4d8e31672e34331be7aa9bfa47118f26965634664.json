{"nodes": [{"id": "claude_conversations_2026_07_04", "label": "2026-07-04 Conversation Log \u2014 App Hang, Offline Launch, Scroll Perf", "file_type": "document", "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_offline_first_launch", "label": "Offline-First Launch (Local-Metadata Fallback)", "file_type": "rationale", "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "do_launch previously required network for version JSON, Java runtime manifest, asset index, and the Forge installer on every launch. Changed to local-first: use cached files under versions/<id>, indexes/<id>.json, and existing runtime/Forge-profile directories when present, only fetching on the first-ever launch of a version."}, {"id": "concept_app_hang_on_close_fix", "label": "App Hangs on Close While Game Running \u2014 Fix", "file_type": "rationale", "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "spawn_log_reader used tokio::task::spawn_blocking to read game stdout/stderr; tokio's runtime waits for all blocking tasks to finish on drop, but the pipe only EOFs when the game exits, hanging app shutdown. Fixed by using std::thread::spawn (independent OS thread, reclaimed on process exit) instead."}], "edges": [{"source": "claude_conversations_2026_07_04", "target": "concept_app_hang_on_close_fix", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "weight": 1.0}, {"source": "claude_conversations_2026_07_04", "target": "concept_offline_first_launch", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "weight": 1.0}, {"source": "claude_conversations_2026_07_04", "target": "concept_scroll_virtualization_perf", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "weight": 1.0}, {"source": "claude_conversations_2026_07_04", "target": "claude_conversations_2026_07_03", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "weight": 1.0}, {"source": "concept_app_hang_on_close_fix", "target": "concept_session_tracking_close_to_minimize", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".claude/conversations/2026-07-04.md", "source_location": null, "weight": 1.0}], "hyperedges": []}