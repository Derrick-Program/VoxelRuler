{"nodes": [{"id": "docs_superpowers_plans_2026_07_06_session_tracking_and_close_to_minimize", "label": "Play-Session Tracking + Close-to-Minimize Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_mc_instance_record_launch_started", "label": "InstanceStore::record_launch_started", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept on InstanceStore rather than inline in the launch closure so it is unit-testable without a real child process; sets last_played the moment a launch succeeds, matching official-launcher convention and surviving a hard-killed launcher."}, {"id": "src_mc_instance_record_play_session_end", "label": "InstanceStore::record_play_session_end", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accumulates (+=) play_time_secs rather than overwriting; write must complete synchronously before the pending-quit decision is evaluated for the same exit event."}, {"id": "src_view_launch_setup_launch_logic", "label": "setup_launch_logic (src/view/launch.rs)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_view_mod_on_close_requested", "label": "on_close_requested handler (src/view/mod.rs)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimizes instead of quitting when running_procs is non-empty; the app only actually quits once every running instance has exited cleanly, and any crash while pending_quit is set restores the window instead."}, {"id": "src_view_mod_pending_quit", "label": "pending_quit AtomicBool flag", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordinates the deferred-quit decision between on_close_requested and the exit-poll loop: a clean exit while set actually quits the app; any instance crashing while set immediately cancels the deferred quit and restores the window, regardless of other still-running instances."}], "edges": [{"source": "docs_superpowers_plans_2026_07_06_session_tracking_and_close_to_minimize", "target": "src_mc_instance_record_launch_started", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_06_session_tracking_and_close_to_minimize", "target": "src_mc_instance_record_play_session_end", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_06_session_tracking_and_close_to_minimize", "target": "src_view_launch_setup_launch_logic", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-06-session-tracking-and-close-to-minimize.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpower