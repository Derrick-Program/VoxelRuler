import { AppTheme } from "@theme";
import { Assets } from "@assets";

export enum SideTabId {
    home,
    instances,
    mods,
    downloads,
    account,
    settings
}

export struct AccountRow {
    checked: bool,
    authenticator: string,
    username: string,
    status: string,
    avatar: image,
}

export struct InstanceData {
    id: string,
    name: string,
    version: string,
    mod_loader: string,
    last_played: string,
    play_time: string,
    image: image,
    status: string,
}

export struct LogLine {
    text: string,
    color: color,
}

export global AppData {
    in property <string> version: @tr("version not found");
    // 網路狀態（footer status）：checking = 尚未完成第一次偵測
    in-out property <bool> network-checking: true;
    in-out property <bool> is-online: false;
}

export global AppLogic {
    callback check_for_updates();
    callback start_download();
    callback sidebar_change(SideTabId);

    check_for_updates => {
        debug("Checking for updates...");
    }
    start_download => {
        debug("Starting download...");
    }

    sidebar_change(id) => {
        debug(id);
    }
}

