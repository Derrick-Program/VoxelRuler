{"nodes": [{"id": "docs_superpowers_specs_2026_07_07_resource_path_picker_design", "label": "World/Resource/Shader Path Picker \u2014 Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-07-resource-path-picker-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_resource_path_picker_redirection", "label": "World/Resource/Shader Pack Path Redirection via Symlink/Junction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-07-resource-path-picker-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redirection happens at launch time via a directory-level symlink (macOS/Linux) or NTFS junction (Windows, via the junction crate \u2014 avoids requiring Developer Mode/admin elevation that std::os::windows::fs::symlink_dir would need), never by copying files. sync_custom_dirs refuses to replace a real non-empty directory to avoid silently deleting user-added mods/resourcepacks, and runs before any network/download work for fail-fast behavior."}, {"id": "src_view_launch_do_launch", "label": "do_launch() (src/view/launch.rs)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-07-07-resource-path-picker-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_instance_assets_sync_custom_dirs", "label": "sync_custom_dirs() (src/instance_assets.rs)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-07-07-resource-path-picker-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_07_resource_path_picker_design", "target": "concept_resource_path_picker_redirection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":