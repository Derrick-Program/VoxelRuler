export global PageAccountLogic {
    in-out property <bool> is_logging_in: false;
    in-out property <string> login_url: "";
    in-out property <string> login_status_text: @tr("Initializing authentication...");
    in-out property <bool> is_error: false;
    in-out property <bool> show_offline_dialog: false;
    in-out property <string> offline_username: "";
    in-out property <int> selected-index: -1;
    in-out property <[AccountRow]> accounts: [];
    in-out property <AccountRow> active-account: {
        username: "Guest",
        authenticator: "No Account",
        status: "Offline",
        checked: false,
        avatar: Assets.user
    };

    callback login_with_microsoft();
    callback cancel_login();
    callback open_browser_url(string);
    callback add-offline-account();
    callback confirm-add-offline-account(string);
    callback refresh-account();
    callback remove-account();
    callback set-default-account();
    callback unset-default-account();
    callback manage-appearance();

    login_with_microsoft => { debug("Login button clicked"); }
    cancel_login => { debug("Login canceled by user"); }
    open_browser_url(url) => { debug("Opening URL in browser: " + url); }
    add-offline-account => { debug("Add offline account"); }
    refresh-account => { debug("Refresh account"); }
    remove-account => { debug("Remove account"); }
    set-default-account => { debug("Set default account"); }
    unset-default-account => { debug("Unset default account"); }
    manage-appearance => { debug("Manage appearance"); }
}

export global InstanceEditLogic {
    // Dialog control
    in-out property <bool>     show-dialog: false;
    // 目標實例
    in-out property <string>   instance-id: "";
    in-out property <string>   instance-name: "";
    // 記憶體
    in-out property <string>   xmx: "2G";
    in-out property <string>   xms: "512M";
    // Java 模式：使用全域 / 使用 Minecraft runtime / 使用自訂 Java
    in-out property <[string]> java-mode-list: [];
    in-out property <string>   selected-java-mode: "";
    // 系統掃描到的 Java 安裝路徑
    in-out property <[string]> detected-java-list: [];
    // 自訂 Java 路徑（僅「使用自訂 Java」時生效）
    in-out property <string>   java-path: "";
    // State
    in-out property <string>   error-msg: "";

    callback confirm-edit();
    callback cancel-edit();
    // 開啟系統檔案選擇框
    callback browse-java();
}

export global SettingsLogic {
    // 全域 Java 模式：使用 Minecraft runtime / 使用自訂 Java
    in-out property <[string]> java-mode-list: [];
    in-out property <string>   selected-java-mode: "";
    // 系統掃描到的 Java 安裝路徑
    in-out property <[string]> detected-java-list: [];
    // 自訂 Java 路徑（僅「使用自訂 Java」時生效）
    in-out property <string>   java-path: "";
    in-out property <string>   status-msg: "";

    callback save-settings();
    // 開啟系統檔案選擇框
    callback browse-java();
}
export struct CapeData {
    id: string,
    alias: string,
    state: string,
    url: string,
    preview: image,
}

export struct SkinData {
    id: string,
    name: string,
    variant: string,
    url: string,
    preview-image: image,
    has-preview: bool,
}

export global AppearanceLogic {
    in-out property <bool>   show-appearance: false;
    in-out property <bool>   is-uploading: false;
    in-out property <string> upload-status: "";
    in-out property <bool>   upload-is-error: false;
    in-out property <string> skin-url: "";
    in-out property <string> selected-skin-path: "";
    in-out property <string> skin-variant: "classic";
    in-out property <image>  preview-image;
    in-out property <bool>   has-preview: false;
    in-out property <string> active-skin-url: "";
    in-out property <string> selected-library-skin-url: "";
    in-out property <string> new-skin-name: "";

    in-out property <[CapeData]> capes: [];
    in-out property <bool>   has-capes: false;
    in-out property <string>   active-cape-id: "";
    in-out property <string>   selected-cape-id: "";
    in-out property <string>   selected-cape-name: @tr("No Cape");
    in-out property <image>    selected-cape-preview;

    in-out property <[SkinData]> skin-history: [];
    in-out property <bool>   has-skin-history: false;

    in-out property <bool>   show-result-dialog: false;

    in-out property <float>  preview-yaw: 30.0;
    in-out property <float>  preview-pitch: 15.0;
    in-out property <float>  preview-time: 0.0;
    in-out property <float>  base-yaw: 30.0;
    in-out property <float>  base-pitch: 15.0;

    callback close-appearance();
    callback browse-skin-file();
    callback upload-from-file();
    callback upload-from-url(string);
    callback preview-library-skin(string);
    callback save-to-library();
    callback select-cape(string);
    callback apply-cape(string);
    callback apply-history-skin(SkinData);
    callback delete-skin(string);
    callback close-result-dialog();
    callback preview-drag-started();
    callback preview-dragged(float, float);
    callback preview-drag-ended();
    
    callback apply-appearance();

    close-appearance    => { debug("Close appearance"); }
    browse-skin-file    => { debug("Browse skin file"); }
    upload-from-file    => { debug("Upload from file"); }
    upload-from-url(u)  => { debug("Upload from url: " + u); }
    delete-skin(id)     => { debug("Delete skin: " + id); }
    close-result-dialog => { show-result-dialog = false; }
}

export global InstanceCreateLogic {
    // Dialog control
    in-out property <bool>     show-dialog: false;
    in-out property <int>      active-tab: 0;
    // Basic Tab
    in-out property <string>   name: "";
    in-out property <[string]> version-list: [];
    in-out property <string>   selected-version: "";
    in-out property <string>   mod-loader: "None";

    // Version filtering
    in-out property <string>   version-search-text: "";
    in-out property <bool>     show-release: true;
    in-out property <bool>     show-snapshot: false;
    in-out property <bool>     show-beta: false;
    in-out property <bool>     show-alpha: false;
    in-out property <bool>     show-experimental: false;
    callback filter-versions();

    // Advanced Tab
    in-out property <string>   xmx: "2G";
    in-out property <string>   xms: "512M";
    in-out property <bool>     logs-enabled: true;

    // Resources Tab
    in-out property <string>   world-path: "";
    in-out property <string>   resource-pack: "";
    in-out property <string>   shader-pack: "";

    // State
    in-out property <string>   error-msg: "";
    in-out property <bool>     is-loading: false;

    // Mod Loader Versions
    in-out property <[string]> mod-loader-versions: [];
    in-out property <string>   selected-mod-loader-version: "";
    callback loader-changed();

    // Scroll-to-selection helpers (set alongside selected-*-version)
    in-out property <int> selected-version-index: -1;
    in-out property <int> selected-loader-index: -1;

    callback confirm-create();
    callback cancel-create();
}